{% for vm in vms %}
[{{ vm.group }}]
{{ vm.name }} ansible_host={{ vm.interfaces[0].ip }} ansible_ssh_private_key_file={{ vagrant_workdir }}/.vagrant/machines/{{ vm.name }}/{{ vagrant_provider }}/private_key

{% endfor %}
[all:vars]
ansible_user=vagrant
ansible_ssh_common_args='-o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no'
